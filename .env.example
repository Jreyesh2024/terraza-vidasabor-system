# =========================================================
# LA TERRAZA DE VIDA & SABOR (V&S) - VARIABLES DE ENTORNO
# Base de Datos PostgreSQL Independiente (DBterrazavidasabor)
# =========================================================

# Clave de Conexión Anvil Uplink (Generada en Anvil.works -> App Settings -> Services -> Uplink)
ANVIL_UPLINK_KEY=server_REEMPLAZAR_CON_TU_LLAVE_DE_ANVIL

# Cadena de Conexión PostgreSQL (pgAdmin / Mac Mini)
DATABASE_URL=postgresql://postgres:password@localhost:5432/DBterrazavidasabor

# Configuración del Servidor Local
PORT=3000
NODE_ENV=development
